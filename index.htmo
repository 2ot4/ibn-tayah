<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مطعم وكافيه ابن تايه - Ibn Tayah</title>
    <!-- Google Fonts & Font Awesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #d97706;
            --primary-hover: #b45309;
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --text-light: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #ef4444;
            --border-color: #334155;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            padding-bottom: 90px;
        }

        /* Header Navigation */
        header {
            background-color: rgba(30, 41, 59, 0.95);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid var(--border-color);
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--primary);
        }

        .logo i {
            font-size: 1.5rem;
        }

        .cart-icon-btn {
            position: relative;
            background: var(--primary);
            border: none;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .cart-badge {
            background: var(--accent);
            color: white;
            border-radius: 50%;
            padding: 2px 7px;
            font-size: 0.8rem;
        }

        /* Banner */
        .hero {
            text-align: center;
            padding: 30px 15px;
            background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.9)), url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=800&q=80') center/cover;
            border-bottom: 1px solid var(--border-color);
        }

        .hero h1 {
            font-size: 2rem;
            color: var(--primary);
            margin-bottom: 8px;
        }

        .hero p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        /* Category Filter */
        .categories {
            display: flex;
            overflow-x: auto;
            gap: 10px;
            padding: 15px 20px;
            scroll-behavior: smooth;
        }

        .categories::-webkit-scrollbar {
            display: none;
        }

        .cat-btn {
            background: var(--card-bg);
            color: var(--text-light);
            border: 1px solid var(--border-color);
            padding: 8px 18px;
            border-radius: 25px;
            white-space: nowrap;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }

        .cat-btn.active, .cat-btn:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: white;
        }

        /* Menu Grid */
        .menu-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 15px 20px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .menu-card {
            background: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .menu-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .card-body {
            padding: 15px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .card-desc {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 12px;
            line-height: 1.4;
            flex-grow: 1;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 10px;
        }

        .price {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--primary);
        }

        .add-btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Modal / Cart Drawer */
        .cart-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 200;
            display: none;
            justify-content: center;
            align-items: flex-end;
        }

        .cart-modal.active {
            display: flex;
        }

        .cart-content {
            background: var(--card-bg);
            width: 100%;
            max-width: 500px;
            max-height: 85vh;
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            padding: 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .cart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px;
        }

        .close-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 1.5rem;
            cursor: pointer;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid var(--border-color);
        }

        .item-info {
            flex-grow: 1;
        }

        .item-title {
            font-weight: 700;
            font-size: 0.95rem;
        }

        .item-price {
            color: var(--primary);
            font-size: 0.85rem;
        }

        .qty-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .qty-btn {
            background: var(--bg-dark);
            color: white;
            border: 1px solid var(--border-color);
            width: 28px;
            height: 28px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 700;
        }

        .checkout-form {
            margin-top: 15px;
        }

        .form-group {
            margin-bottom: 10px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 4px;
        }

        .form-group input, .form-group textarea {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: var(--bg-dark);
            color: white;
            font-size: 0.9rem;
        }

        .order-btn {
            background: #25d366;
            color: white;
            width: 100%;
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-weight: 800;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-top: 10px;
        }

        /* Fixed Bottom Cart Bar */
        .cart-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: var(--card-bg);
            border-top: 1px solid var(--border-color);
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 90;
        }

        .cart-summary {
            display: flex;
            flex-direction: column;
        }

        .total-price {
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--primary);
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="logo">
            <i class="fa-solid fa-utensils"></i>
            <span>ابن تايه</span>
        </div>
        <button class="cart-icon-btn" onclick="toggleCart()">
            <i class="fa-solid fa-cart-shopping"></i>
            <span>السلة</span>
            <span class="cart-badge" id="cartBadge">0</span>
        </button>
    </header>

    <!-- Banner -->
    <section class="hero">
        <h1>مطعم وكافيه ابن تايه</h1>
        <p>أطيب المأكولات والمشروبات في بغداد - طلبك يوصلك أونلاين عبر الواتساب</p>
    </section>

    <!-- Categories Filter -->
    <div class="categories" id="categoryContainer">
        <button class="cat-btn active" onclick="filterCategory('all', this)">الكل</button>
        <button class="cat-btn" onclick="filterCategory('مشويات', this)">مشويات</button>
        <button class="cat-btn" onclick="filterCategory('وجبات سريعة', this)">وجبات سريعة</button>
        <button class="cat-btn" onclick="filterCategory('مشروبات', this)">مشروبات وكافيه</button>
        <button class="cat-btn" onclick="filterCategory('حلويات', this)">حلويات</button>
    </div>

    <!-- Menu Items -->
    <div class="menu-container" id="menuContainer">
        <!-- Dynamic Content injected via JS -->
    </div>

    <!-- Bottom Cart Bar -->
    <div class="cart-bar">
        <div class="cart-summary">
            <span style="font-size: 0.8rem; color: var(--text-muted);">المجموع الكلي:</span>
            <span class="total-price" id="barTotalPrice">0 د.ع</span>
        </div>
        <button class="add-btn" style="padding: 10px 20px; font-size: 1rem;" onclick="toggleCart()">
            عرض السلة <i class="fa-solid fa-arrow-left"></i>
        </button>
    </div>

    <!-- Cart Modal -->
    <div class="cart-modal" id="cartModal">
        <div class="cart-content">
            <div class="cart-header">
                <h3><i class="fa-solid fa-basket-shopping"></i> سلة الطلبات</h3>
                <button class="close-btn" onclick="toggleCart()">&times;</button>
            </div>
            
            <div id="cartItems">
                <!-- Items list -->
            </div>

            <div class="checkout-form">
                <div class="form-group">
                    <label>الاسم الكامل *</label>
                    <input type="text" id="custName" placeholder="أدخل اسمك الكريم">
                </div>
                <div class="form-group">
                    <label>عنوان التوصيل بالتفصيل *</label>
                    <input type="text" id="custAddress" placeholder="المنطقة، الشارع، أقرب دالة">
                </div>
                <div class="form-group">
                    <label>ملاحظات إضافية</label>
                    <textarea id="custNotes" rows="2" placeholder="أي إضافات أو تعديلات على الطلب"></textarea>
                </div>
                <button class="order-btn" onclick="sendWhatsAppOrder()">
                    <i class="fa-brands fa-whatsapp"></i> إرسال الطلب عبر الواتساب
                </button>
            </div>
        </div>
    </div>

    <script>
        // Menu Data
        const menuItems = [
            { id: 1, name: "كباب لحم عراقي", category: "مشويات", price: 12000, desc: "نفر كباب لحم غنم مع الخبز الحار والسلاطات", img: "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&w=500&q=80" },
            { id: 2, name: "شيش طاووق", category: "مشويات", price: 10000, desc: "قطع دجاج متبلة ومأكولة على الفحم", img: "https://images.unsplash.com/photo-1598515214211-89d3c73ae83b?auto=format&fit=crop&w=500&q=80" },
            { id: 3, name: "برغر ابن تايه الملكي", category: "وجبات سريعة", price: 8000, desc: "شريحة لحم بقر مقرمشة مع الجبن والصلصة الخاصة", img: "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=500&q=80" },
            { id: 4, name: "بيتزا ميكس لحم", category: "وجبات سريعة", price: 11000, desc: "بيتزا بجبنة الموزاريلا الغنية والخضار واللحم", img: "https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=500&q=80" },
            { id: 5, name: "قهوة اسبريسو", category: "مشروبات", price: 3000, desc: "قهوة مركزة ومحضرة من أجود حبوب البن", img: "https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=500&q=80" },
            { id: 6, name: "عصير برتقال طبيعي", category: "مشروبات", price: 4000, desc: "عصير برتقال طازج 100%", img: "https://images.unsplash.com/photo-1613478223719-2ab802602423?auto=format&fit=crop&w=500&q=80" },
            { id: 7, name: "وافل مع الشوكولاتة", category: "حلويات", price: 6000, desc: "وافل هشش مقرمش مغطى بنوتيلا والوافل", img: "https://images.unsplash.com/photo-1562376552-0d160a2f238d?auto=format&fit=crop&w=500&q=80" }
        ];

        let cart = [];

        // Render Menu
        function renderMenu(items) {
            const container = document.getElementById('menuContainer');
            container.innerHTML = items.map(item => `
                <div class="menu-card">
                    <img src="${item.img}" alt="${item.name}">
                    <div class="card-body">
                        <div class="card-title">${item.name}</div>
                        <div class="card-desc">${item.desc}</div>
                        <div class="card-footer">
                            <span class="price">${item.price.toLocaleString()} د.ع</span>
                            <button class="add-btn" onclick="addToCart(${item.id})">
                                <i class="fa-solid fa-plus"></i> إضافة
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Filter Categories
        function filterCategory(cat, btn) {
            document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            if (cat === 'all') {
                renderMenu(menuItems);
            } else {
                renderMenu(menuItems.filter(i => i.category === cat));
            }
        }

        // Add to Cart
        function addToCart(id) {
            const item = menuItems.find(i => i.id === id);
            const existing = cart.find(i => i.id === id);
            if (existing) {
                existing.qty++;
            } else {
                cart.push({ ...item, qty: 1 });
            }
            updateCart();
        }

        // Update Cart State
        function updateCart() {
            const badge = document.getElementById('cartBadge');
            const barTotal = document.getElementById('barTotalPrice');
            const cartItems = document.getElementById('cartItems');

            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            badge.innerText = totalQty;
            barTotal.innerText = totalPrice.toLocaleString() + ' د.ع';

            if (cart.length === 0) {
                cartItems.innerHTML = '<p style="text-align:center; color: var(--text-muted); padding: 20px;">السلة فارغة حالياً</p>';
            } else {
                cartItems.innerHTML = cart.map(item => `
                    <div class="cart-item">
                        <div class="item-info">
                            <div class="item-title">${item.name}</div>
                            <div class="item-price">${(item.price * item.qty).toLocaleString()} د.ع</div>
                        </div>
                        <div class="qty-controls">
                            <button class="qty-btn" onclick="changeQty(${item.id}, -1)">-</button>
                            <span>${item.qty}</span>
                            <button class="qty-btn" onclick="changeQty(${item.id}, 1)">+</button>
                        </div>
                    </div>
                `).join('');
            }
        }

        function changeQty(id, delta) {
            const item = cart.find(i => i.id === id);
            if (item) {
                item.qty += delta;
                if (item.qty <= 0) {
                    cart = cart.filter(i => i.id !== id);
                }
            }
            updateCart();
        }

        function toggleCart() {
            document.getElementById('cartModal').classList.toggle('active');
        }

        // WhatsApp Order Integration
        function sendWhatsAppOrder() {
            const name = document.getElementById('custName').value.trim();
            const address = document.getElementById('custAddress').value.trim();
            const notes = document.getElementById('custNotes').value.trim();

            if (cart.length === 0) {
                alert('يرجى إضافة وجبات إلى السلة أولاً!');
                return;
            }
            if (!name || !address) {
                alert('يرجى إدخال الاسم والتلفون والعنوان بالكامل!');
                return;
            }

            const phone = "9647700000000"; // يمكنك تغيير هذا الرقم إلى رقم واتساب المطعم الخاص بك
            let message = `*طلب جديد من مطعم وكافيه ابن تايه* 🍔🍕\n\n`;
            message += `*الاسم:* ${name}\n`;
            message += `*العنوان:* ${address}\n`;
            if (notes) message += `*ملاحظات:* ${notes}\n`;
            message += `\n*الطلبات:*\n`;

            cart.forEach(item => {
                message += `- ${item.name} (العدد: ${item.qty}) -> ${(item.price * item.qty).toLocaleString()} د.ع\n`;
            });

            const total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            message += `\n*المجموع الكلي:* ${total.toLocaleString()} د.ع`;

            const encodedMessage = encodeURIComponent(message);
            window.open(`https://wa.me/${phone}?text=${encodedMessage}`, '_blank');
        }

        // Initial Render
        renderMenu(menuItems);
    </script>
</body>
</html>
